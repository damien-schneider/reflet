{
  "name": "@reflet/mcp-server",
  "version": "0.1.0",
  "description": "Reflet MCP Server - AI agents can manage feedback, releases, milestones, and more",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "reflet-mcp-server": "./dist/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "check-types": "tsc --noEmit",
    "lint": "cd ../.. && bun x ultracite check packages/mcp-server",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
