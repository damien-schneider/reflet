{
  "name": "@reflet/bridge",
  "version": "0.1.0",
  "description": "Local Reflet Bridge CLI for running repo-native product harness jobs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reflet-app/reflet.git",
    "directory": "packages/bridge"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "reflet-bridge": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit",
    "prepublishOnly": "bun run build",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@reflet/config": "workspace:*",
    "@reflet/harness": "workspace:*",
    "@types/node": "^25.5.0",
    "tsup": "^8.5.1",
    "typescript": "catalog:",
    "vitest": "^4.1.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
