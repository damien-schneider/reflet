{
  "name": "reflet-cli",
  "version": "0.2.0",
  "description": "Add the Reflet feedback widget to any app and drive the Reflet admin API from your terminal",
  "keywords": [
    "reflet",
    "feedback",
    "widget",
    "cli",
    "bug-report",
    "screenshot",
    "agent"
  ],
  "homepage": "https://reflet.app",
  "bugs": {
    "url": "https://github.com/reflet-app/reflet/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/reflet-app/reflet.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "author": "Reflet <hello@reflet.app>",
  "type": "module",
  "exports": {
    "./agent-prompt": "./src/agent-prompt.ts",
    "./prompt": "./src/setup-prompt.ts"
  },
  "bin": {
    "reflet": "./dist/index.js",
    "reflet-cli": "./dist/index.js"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "dev": "tsdown --watch",
    "lint": "cd ../.. && bun x ultracite check packages/cli",
    "prepublishOnly": "npm run build",
    "test:unit": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
