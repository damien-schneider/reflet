{
  "name": "reflet-sdk",
  "version": "0.4.1",
  "description": "Official Reflet SDK - Collect user feedback, feature requests, and bug reports from your app",
  "keywords": [
    "feedback",
    "feature-requests",
    "bug-reports",
    "user-feedback",
    "product-feedback",
    "widget",
    "sdk",
    "react",
    "react-hooks",
    "typescript",
    "reflet",
    "roadmap",
    "changelog"
  ],
  "homepage": "https://reflet.app",
  "bugs": {
    "url": "https://github.com/reflet-app/reflet/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reflet-app/reflet.git",
    "directory": "packages/sdk"
  },
  "license": "MIT",
  "author": "Reflet <hello@reflet.app>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./feedback": {
      "types": "./dist/feedback.d.ts",
      "import": "./dist/feedback.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "dev": "tsdown --watch",
    "lint": "cd ../.. && bun x ultracite check packages/sdk",
    "prepublishOnly": "npm run build",
    "release": "npm run build && npm publish",
    "test:unit": "vitest run",
    "version:major": "npm version major && npm run release",
    "version:minor": "npm version minor && npm run release",
    "version:patch": "npm version patch && npm run release"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@zumer/snapdom": "^3.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "^30.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
