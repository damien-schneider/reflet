# Copy to .env.local for development, .env.production for production.
# Convex functions read these through the deployment's environment:
#   npx convex env set NAME value

# Convex
CONVEX_DEPLOYMENT=dev:your-deployment
CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_SITE_URL=https://your-deployment.convex.site
SITE_URL=http://localhost:3003
# Extra origins allowed to call the auth endpoints, comma separated
ADDITIONAL_TRUSTED_ORIGINS=

# Auth - generate secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Skip email verification for e2e tests only
# SKIP_EMAIL_VERIFICATION=true

# AI - https://openrouter.ai/keys
OPENROUTER_API_KEY=

# GitHub App (org integration) - https://github.com/settings/apps
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Custom domains - Vercel project that serves the web app
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# Stripe - https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...

# Email - https://resend.com/api-keys
RESEND_API_KEY=
# Signing secret of the Resend webhook pointing at https://<deployment>.convex.site/resend-webhook
RESEND_WEBHOOK_SECRET=
RESEND_FROM_EMAIL=notifications@mail.reflet.app
# Support email: full-access Resend key (manages customer sending domains)
RESEND_SUPPORT_API_KEY=
# Signing secrets of the Resend webhooks pointing at /resend-support-events and /resend-support-inbound
RESEND_SUPPORT_EVENTS_WEBHOOK_SECRET=
RESEND_SUPPORT_INBOUND_WEBHOOK_SECRET=
SUPPORT_INBOUND_DOMAIN=inbox.reflet.app

# Push Notifications - generate with: bunx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:team@reflet.app
