{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["!.agents", "!**/.agents"]
  },
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/remix"
  ],
  "linter": {
    "rules": {
      "complexity": {
        "noRedundantDefaultExport": "off"
      },
      "performance": {
        "noAwaitInLoops": "off",
        "noJsxPropsBind": "off"
      },
      "style": {
        "noIncrementDecrement": "off",
        "useDestructuring": "off",
        "useErrorCause": "off"
      },
      "suspicious": {
        "noEmptySource": "off",
        "noLeakedRender": "off",
        "noShadow": "off",
        "noUnnecessaryConditions": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/backend/convex/_generated/**/*",
        "apps/web/playwright-report/**/*",
        "apps/web/test-results/**/*",
        "apps/web/public/r/**/*",
        "**/node_modules/**",
        "**/*.gen.ts"
      ],
      "linter": {
        "enabled": false
      },
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["apps/web/src/components/ui/**/*"],
      "linter": {
        "enabled": false
      }
    },
    {
      "includes": ["**/*.svg"],
      "linter": {
        "rules": {
          "a11y": {
            "noSvgWithoutTitle": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "noNoninteractiveElementInteractions": "off",
            "useKeyWithClickEvents": "off",
            "noStaticElementInteractions": "off",
            "useFocusableInteractive": "off",
            "useAriaPropsForRole": "off"
          },
          "performance": {
            "useTopLevelRegex": "off",
            "noImgElement": "off"
          },
          "suspicious": {
            "useAwait": "off",
            "noEmptyBlockStatements": "off",
            "noExplicitAny": "off",
            "noNonNullAssertedOptionalChain": "off"
          },
          "correctness": {
            "noUnusedFunctionParameters": "off",
            "useImageSize": "off",
            "noUnusedVariables": "warn"
          },
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/backend/convex/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    }
  ]
}
