# Copy to .env.local. Values are validated in packages/env/src/web.ts (NEXT_PUBLIC_*)
# and packages/env/src/server.ts (server only).

# ----------------------------- Convex ---------------------------
# Get from: https://dashboard.convex.dev
NEXT_PUBLIC_CONVEX_URL="https://your-deployment.convex.cloud"
NEXT_PUBLIC_CONVEX_SITE_URL="https://your-deployment.convex.site"

# ----------------------------- Site -----------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3003"
# Apex domain that hosts org subdomains (<slug>.reflet.app); defaults to reflet.app
# NEXT_PUBLIC_ROOT_DOMAIN="reflet.app"
# Public key of the Reflet org that collects feedback about reflet.app itself
# NEXT_PUBLIC_REFLET_PUBLIC_KEY="fb_pub_..."

# ----------------------------- GitHub App -----------------------------
# Create a GitHub App: https://github.com/settings/apps
# Required permissions: Repository contents (read), Issues (read/write)
# Webhook URL: https://your-deployment.convex.site/github-webhook
# Setup URL and Callback URL: https://your-site/api/github/callback
# Client ID/secret: from the GitHub App settings page (user-to-server tokens)
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# ----------------------------- VAPID (Push Notifications) ----------
# Generate with: bunx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ----------------------------- OpenRouter (AI) -----------------------------
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ----------------------------- PostHog (optional) -----------------------------
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"
# Source map upload at build time
# POSTHOG_PERSONAL_API_KEY=
# POSTHOG_PROJECT_ID=

# ----------------------------- E2E Testing -----------------------------
# Skip email verification for e2e tests (set to "true" to enable)
# NEXT_PUBLIC_SKIP_EMAIL_VERIFICATION="true"

# ----------------------------- Stripe (Reference) -----------------------------
# Stripe keys live in Convex environment variables (see packages/backend/.env.example).
