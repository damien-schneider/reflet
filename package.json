{
  "name": "reflet",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.6.5",
      "typescript": "^7.0.2",
      "tsdown": "^0.23.0",
      "vite": "^8.3.0",
      "vitest": "^5.0.1",
      "convex": "^1.46.0",
      "better-auth": "~1.6.33",
      "@convex-dev/better-auth": "^0.12.5"
    }
  },
  "scripts": {
    "build": "turbo build",
    "check-types": "turbo check-types",
    "clean": "rm -rf node_modules .turbo .next bun.lock && bun install",
    "dev": "turbo dev",
    "dev:native": "turbo -F native dev",
    "dev:server": "turbo -F @reflet/backend dev",
    "dev:setup": "turbo -F @reflet/backend dev:setup",
    "dev:web": "turbo -F web dev",
    "prepare": "husky",
    "start": "turbo -F web start",
    "test:e2e": "cd apps/web && bunx playwright test --reporter=list",
    "test:unit": "turbo run test:unit"
  },
  "overrides": {
    "prosemirror-model": "^1.25.11",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.0",
    "prosemirror-view": "^1.42.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@reflet/config": "workspace:*",
    "@types/node": "^26.1.2",
    "husky": "^9.1.7",
    "turbo": "^2.10.13",
    "typescript": "catalog:",
    "ultracite": "7.12.0"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  }
}
